+// Re-anchors imports issued from files that live outside the perfetto
+// checkout. Embedders may symlink individual sources from their own tree into
+// ui/src/<...>; Rollup canonicalises those symlinks before module resolution
+// runs, so subsequent imports (bare or relative) try to resolve relative to
+// the embedder repo where neither perfetto's node_modules nor the rest of
+// ui/src exist. This plugin walks ui/src/ to build a canonical→symlink map,
+// then re-runs resolution as if the importer were at its symlink site inside
+// perfetto. The map is cached; on a miss we re-walk once before giving up so
+// symlinks created after the dev server started (e.g. a fresh overlay file)
+// are picked up without a restart.
+function pluginOverlayDepResolution() {
+  let symlinkMap = null;
+  function refresh() {
+    const map = new Map();
+    function walk(dir) {
+      let entries;
+      try {
+        entries = fs.readdirSync(dir, {withFileTypes: true});
+      } catch (_) { return; }
+      for (const ent of entries) {
+        const full = path.join(dir, ent.name);
+        if (ent.isSymbolicLink()) {
+          try {
+            const real = fs.realpathSync(full);
+            if (!real.startsWith(ROOT_DIR + path.sep)) map.set(real, full);
+          } catch (_) {}
+        } else if (ent.isDirectory()) {
+          walk(full);
+        }
+      }
+    }
+    walk(SRC);
+    symlinkMap = map;
+    return symlinkMap;
+  }
+  return {
+    name: 'perfetto:overlay-dep-resolution',
+    enforce: 'pre',
+    async resolveId(source, importer) {
+      if (!importer || source.includes('\0')) return null;
+      if (importer.startsWith(ROOT_DIR + path.sep)) return null;
+      const importerFile = importer.split('?')[0];
+      let map = symlinkMap ?? refresh();
+      let symlinkImporter = map.get(importerFile);
+      if (!symlinkImporter) {
+        // Miss — could be a symlink that appeared after the cache was built.
+        // Re-walk once and retry; if it's still not there, give up.
+        map = refresh();
+        symlinkImporter = map.get(importerFile);
+        if (!symlinkImporter) return null;
+      }
+      return this.resolve(source, symlinkImporter, {skipSelf: true});
+    },
+  };
+}

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lalit Maganti <lalitmaganti@gmail.com>
Date: Wed, 1 Jan 2025 00:00:00 +0000
Subject: nopr: tab closable

Allow detail tabs to be closable. Sismo-local; no upstream PR yet.
---
 ui/src/core_plugins/dev.perfetto.Timeline/tab_panel.ts | 2 +-
 ui/src/public/tab.ts                                   | 3 +++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/ui/src/core_plugins/dev.perfetto.Timeline/tab_panel.ts b/ui/src/core_plugins/dev.perfetto.Timeline/tab_panel.ts
index 1f13a1a2..9818ba70 100644
--- a/ui/src/core_plugins/dev.perfetto.Timeline/tab_panel.ts
+++ b/ui/src/core_plugins/dev.perfetto.Timeline/tab_panel.ts
@@ -45,7 +45,7 @@ export class TabPanel implements m.ClassComponent<TabPanelAttrs> {
         key: uri,
         title: tab?.content.getTitle() ?? 'Tab does not exist',
         content: tab?.content.render(),
-        closable: true,
+        closable: tab?.closable ?? true,
       })),
     ];
 
diff --git a/ui/src/public/tab.ts b/ui/src/public/tab.ts
index 382b5ab0..de8e2890 100644
--- a/ui/src/public/tab.ts
+++ b/ui/src/public/tab.ts
@@ -30,6 +30,9 @@ export interface TabDescriptor {
   uri: string; // TODO(stevegolton): Maybe optional for ephemeral tabs.
   content: Tab;
   isEphemeral?: boolean; // Defaults false
+  // Whether the user can close this tab from the tab bar. Defaults true.
+  // Set false for tabs that should remain pinned for the trace's lifetime.
+  closable?: boolean;
   onHide?(): void;
   onShow?(): void;
 }

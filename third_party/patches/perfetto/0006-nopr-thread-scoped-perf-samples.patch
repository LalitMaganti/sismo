+  // Sismo extension: what each PerfSample of this sequence is scoped to. CPU
+  // (or the unspecified default, for upstream producers) is a per-cpu sample —
+  // its |timebase_count| / |follower_counts| are cpu-cumulative and routed to
+  // cpu-scoped counter tracks. THREAD is a per-thread sample — the readings are
+  // thread-cumulative, keyed by the sample's tid, and routed to thread-scoped
+  // counter tracks.
+  enum SampleScope {
+    SAMPLE_SCOPE_UNSPECIFIED = 0;
+    SAMPLE_SCOPE_CPU = 1;
+    SAMPLE_SCOPE_THREAD = 2;
+  }

 }
diff --git a/src/trace_processor/importers/common/tracks_common.h b/src/trace_processor/importers/common/tracks_common.h
index bbc128a4..c4c2c211 100644
--- a/src/trace_processor/importers/common/tracks_common.h
+++ b/src/trace_processor/importers/common/tracks_common.h
@@ -284,6 +284,19 @@ inline constexpr auto kPerfCpuCounterBlueprint = tracks::CounterBlueprint(
         tracks::kNameFromTraceDimensionBlueprint),
     tracks::DynamicNameBlueprint());
 
+// Thread-scoped counterpart of kPerfCpuCounterBlueprint: a perf sample's
+// timebase/follower readings accumulated per-thread (see
+// PerfSampleDefaults.SAMPLE_SCOPE_THREAD). The utid dimension nests the
+// counter under its thread in the UI.
+inline constexpr auto kPerfThreadCounterBlueprint = tracks::CounterBlueprint(
+    "perf_thread_counter",
+    tracks::UnknownUnitBlueprint(),
+    tracks::DimensionBlueprints(
+        tracks::kThreadDimensionBlueprint,
+        tracks::UintDimensionBlueprint("perf_session_id"),
+        tracks::kNameFromTraceDimensionBlueprint),
+    tracks::DynamicNameBlueprint());
+
 inline constexpr auto kGlobalGpuMemoryBlueprint = tracks::CounterBlueprint(
     "gpu_memory",
     tracks::kBytesUnitBlueprint,
diff --git a/src/trace_processor/importers/proto/perf_sample_tracker.cc b/src/trace_processor/importers/proto/perf_sample_tracker.cc
index 92a1438c..b3738f60 100644

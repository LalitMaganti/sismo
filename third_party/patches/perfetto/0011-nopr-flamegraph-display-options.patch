+// Distinct values of property `key` across the nodes, sorted — the checklist
+// the "Hide" popup offers for a column.
+function distinctPropertyValues(
+  nodes: ReadonlyArray<FlamegraphNode>,
+  key: string,
+): string[] {
+  const seen = new Set<string>();
+  for (const n of nodes) {
+    const p = n.properties.get(key);
+    if (p !== undefined) seen.add(p.value);
+  }
+  return Array.from(seen).sort();
+}

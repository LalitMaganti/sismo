diff --git a/protos/perfetto/trace/profiling/profile_common.proto b/protos/perfetto/trace/profiling/profile_common.proto
index 456e303f..9c4d8761 100644
--- a/protos/perfetto/trace/profiling/profile_common.proto
+++ b/protos/perfetto/trace/profiling/profile_common.proto
@@ -69,6 +69,14 @@ message ModuleSymbols {
 }
 
 message Mapping {
+  // Coordinate represented by Frame.rel_pc for this mapping. Old traces and
+  // ordinary process mappings use virtual addresses; FILE_OFFSET is for a
+  // process-independent whole-file mapping keyed by build ID.
+  enum AddressKind {
+    VIRTUAL_ADDRESS = 0;
+    FILE_OFFSET = 1;
+  }
+
   // Interning key.
   // Starts from 1, 0 is the same as "not set".
   optional uint64 iid = 1;
@@ -125,6 +133,8 @@ message Mapping {
   // E.g. ["system", "lib64", "libc.so"]
   // id of string.
   repeated uint64 path_string_ids = 7;
+
+  optional AddressKind address_kind = 9;
 }
 
 message Frame {
diff --git a/src/trace_processor/importers/common/create_mapping_params.h b/src/trace_processor/importers/common/create_mapping_params.h
index faab933b..1ea074f5 100644
--- a/src/trace_processor/importers/common/create_mapping_params.h
+++ b/src/trace_processor/importers/common/create_mapping_params.h
@@ -41,10 +41,14 @@ struct CreateMappingParams {
   uint64_t load_bias = 0;
   std::string name;
   std::optional<BuildId> build_id;
+  // protos::pbzero::Mapping::AddressKind numeric value. Kept as an integer so
+  // importers which do not depend on the profiling proto retain a light API.
+  // Last to preserve existing aggregate initializers in other importers.
+  uint32_t address_kind = 0;
 
   auto ToTuple() const {
-    return std::tie(memory_range, exact_offset, start_offset, load_bias, name,
-                    build_id);
+    return std::tie(memory_range, address_kind, exact_offset, start_offset,
+                    load_bias, name, build_id);
   }
 
   bool operator==(const CreateMappingParams& o) const {
